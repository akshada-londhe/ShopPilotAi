# backend/.env.example
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
TAVILY_API_KEY=
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_HOST=https://cloud.langfuse.com
BACKEND_API_KEY=choose-any-random-string-here
# Local dev: relative dir. On Railway point this at a mounted volume, e.g. /data/chroma
CHROMA_PERSIST_DIR=chroma_groq
# Comma-separated allowed CORS origins. Add your Vercel deploy URL for prod.
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Secret for signing user JWTs. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
